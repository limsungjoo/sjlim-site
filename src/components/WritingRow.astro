---
import { formatDate } from '../site';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags?: string[];
  /** 시리즈 소속이면 '시리즈명 · 02' 형태로 레일에 뜬다 */
  seriesLabel?: string;
}
const { href, title, summary, date, tags = [], seriesLabel } = Astro.props;
---

<article class="row">
  <div class="row-rail">
    <time class="meta" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    {seriesLabel && <span class="rail-series">{seriesLabel}</span>}
  </div>

  <div>
    <h3 class="row-title">
      <a href={href} class="row-link">{title}</a>
    </h3>
    <p class="row-summary">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="row-tags">
          {tags.map((t) => (
            <li class="row-tag">#{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  /* 카드 전체를 클릭 영역으로. 링크는 하나만 두어 탭 순서가 늘어나지 않게 한다 */
  .row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .rail-series {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }
</style>
