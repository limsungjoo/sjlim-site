---
import StatusMark from './StatusMark.astro';
import { formatDate } from '../site';

interface Props {
  href: string;
  title: string;
  summary: string;
  status: string;
  touched: Date;
  /** 처음 쓴 뒤 다시 손댄 노트. 목록에서 * 로 표시한다 */
  revised?: boolean;
  tags?: string[];
}

const { href, title, summary, status, touched, revised = false, tags = [] } = Astro.props;
---

<article class="row">
  <div class="row-rail">
    <time class="meta" datetime={touched.toISOString().slice(0, 10)}>
      {formatDate(touched)}{revised && <span class="revised" title="고쳐 쓴 날">*</span>}
    </time>
    <StatusMark status={status} />
  </div>

  <div>
    <h3 class="row-title">
      <a href={href} class="row-link">{title}</a>
    </h3>
    <p class="row-summary">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="row-tags">
          {tags.map((t) => (
            <li class="row-tag">#{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .revised {
    color: var(--accent);
    margin-left: 1px;
  }
</style>
