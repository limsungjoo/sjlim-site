---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';
import { site } from '../../site';

const projects = await getProjects();

const specs = [
  { k: 'ROLE', v: site.role },
  { k: 'STACK', v: 'Python · Kubernetes · Terraform · AWS · Weights & Biases' },
  { k: 'BASED IN', v: site.location },
];

const focus = [
  'Experiment tracking, lineage, reproducibility, and promotion gates',
  'AI agent architecture, evaluation, memory, and developer workflows',
  'GPU infrastructure, Kubernetes scheduling, and research workspaces',
  'CI/CD and policy enforcement for ML repositories',
];

// TODO: 실제 연도로 교체
const experience = [
  {
    period: '2025 –',
    role: 'MLOps & AX Engineer',
    note: 'Experiment tracking standards, GPU platform, and agent workflows',
  },
  {
    period: 'Earlier',
    role: 'Medical imaging research',
    note: 'Computer vision, segmentation, domain adaptation, and radiomics',
  },
  {
    period: 'Ongoing',
    role: 'Open source and internal enablement',
    note: 'Standards documents, shared tooling, and internal talks',
  },
];
---

<BaseLayout title="Portfolio" description={site.description} lang="en">
  <div class="frame">
    <section class="intro">
      <div class="intro-copy">
        <p class="meta">Portfolio</p>
        <h1 class="lead">
          I build systems that make machine learning experiments reproducible, AI agents dependable,
          and compute infrastructure easier for researchers to use.
        </h1>
        <p>
          I care less about model scores than about where a score came from. Most of my work turns a
          judgement call into something a machine can check: a recording contract every run has to
          satisfy, a scheduler that sizes compute from the request instead of a dropdown, a boundary
          between what a repository declares and what a runner executes.
        </p>
        <p>
          Earlier I worked on medical imaging, computer vision, segmentation, domain adaptation, and
          radiomics. I now work across MLOps and AI transformation, connecting model development,
          agent workflows, infrastructure, and the operational controls that hold them together.
        </p>
      </div>

      <dl class="specs">
        {
          specs.map((s) => (
            <div class="spec">
              <dt class="meta">{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))
        }
        <div class="spec">
          <dt class="meta">CONNECT</dt>
          <dd class="spec-links">
            {
              site.links
                .filter((l) => l.label !== 'RSS')
                .map((l) => (
                  <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                    {l.label} ↗
                  </a>
                ))
            }
          </dd>
        </div>
      </dl>
    </section>

    <section class="block">
      <div class="sec-head">
        <h2 class="sec-title">Focus</h2>
      </div>
      <ul class="focus">
        {focus.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section class="block">
      <div class="sec-head">
        <h2 class="sec-title">Work</h2>
        <span class="meta">{projects.length} PROJECTS</span>
      </div>

      <div class="work">
        {
          projects.map((p, i) => (
            <article class="work-row" id={p.id}>
              <span class="work-no" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="work-main">
                <h3>
                  {p.data.link ? (
                    <a href={p.data.link} rel="noopener" class="work-link">
                      {p.data.title} <span class="work-arrow">↗</span>
                    </a>
                  ) : (
                    p.data.title
                  )}
                </h3>
                <p class="work-summary">{p.data.summary}</p>
                <p class="work-stack">{p.data.stack.join(' · ')}</p>
              </div>

              <div class="work-meta">
                <span class="chip" data-state={p.data.state}>
                  {p.data.state}
                </span>
                <span class="meta">{p.data.kind}</span>
                <span class="meta">{p.data.period}</span>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="block">
      <div class="sec-head">
        <h2 class="sec-title">Experience</h2>
      </div>

      <div class="bg">
        {
          experience.map((e) => (
            <article class="bg-row">
              <div>
                <h3>{e.role}</h3>
                <p>{e.note}</p>
              </div>
              <span class="meta bg-period">{e.period}</span>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ── 소개: 글이 왼쪽 넓게, 사양은 오른쪽 좁은 모노 컬럼 ── */
  .intro {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem 1rem;
  }

  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 1.35fr 0.65fr;
      gap: 4rem;
      padding-block: 5rem 1.5rem;
    }
    .specs {
      border-left: 1px solid var(--line);
      padding-left: 2rem;
    }
  }

  .lead {
    margin-top: 1.25rem;
    font-size: clamp(1.4rem, 1rem + 1.7vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.4;
    max-width: 32ch;
  }

  .intro-copy > p:not(.meta) {
    margin-top: 1.25rem;
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.8;
  }

  .spec {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.85rem;
  }
  .spec + .spec {
    border-top: 1px solid var(--line-soft);
  }
  .spec:first-child {
    padding-top: 0;
  }

  .spec dd {
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .spec-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .spec-links a {
    color: var(--accent-ink);
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .spec-links a:hover {
    border-bottom-color: currentColor;
  }

  @media (max-width: 59.999rem) {
    .specs {
      border-top: 1px solid var(--line);
      padding-top: 0.5rem;
    }
    .spec:first-child {
      padding-top: 0.85rem;
    }
  }

  /* ── 섹션 공통 ── */
  .block {
    margin-top: 4rem;
  }

  .sec-head {
    border-bottom: 1px solid var(--line);
  }

  /* ── Focus: 순서가 아니라 목록이라 번호를 붙이지 않는다 ── */
  .focus {
    list-style: none;
    margin-top: 0.25rem;
  }

  .focus li {
    padding: 0.85rem 0 0.85rem 1.15rem;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.9688rem;
    line-height: 1.6;
    position: relative;
  }

  .focus li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.4rem;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  /* ── Work: 큰 인덱스 숫자 + 본문 + 우측 메타 ── */
  .work-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line-soft);
    position: relative;
  }

  @media (min-width: 52rem) {
    .work-row {
      grid-template-columns: 3.25rem 1fr 10rem;
      gap: 1.75rem;
      align-items: start;
    }
  }

  .work-no {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: color 0.16s ease;
  }
  .work-row:hover .work-no {
    color: var(--accent);
  }

  .work-main h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .work-link:hover {
    color: var(--accent-ink);
  }
  .work-arrow {
    font-size: 0.75em;
    color: var(--ink-3);
  }
  .work-link:hover .work-arrow {
    color: inherit;
  }

  .work-summary {
    margin-top: 0.45rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .work-stack {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  @media (min-width: 52rem) {
    .work-meta {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.45rem;
      text-align: right;
    }
  }

  /* ── Experience: 기간을 오른쪽으로 ── */
  .bg-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.3rem 1.5rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  @media (min-width: 46rem) {
    .bg-row {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
    .bg-period {
      text-align: right;
    }
  }

  .bg-row h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .bg-row p {
    margin-top: 0.15rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
</style>
