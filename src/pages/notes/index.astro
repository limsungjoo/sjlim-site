---
import { href } from '../../lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import NoteRow from '../../components/NoteRow.astro';
import { getNotes, touchedAt } from '../../lib/content';
import { NOTE_STATUS, NOTE_STATUS_NOTE } from '../../lib/taxonomy';

const notes = await getNotes();
const verified = notes.filter((n) => n.data.status === 'verified').length;
---

<BaseLayout
  title="Notes"
  description="Short notes on things I ran into. Kept up to date rather than published once."
>
  <div class="frame">
    <PageHead
      eyebrow="Notes"
      title="Notes"
      lead="일하다 알게 된 것을 짧게 적어둡니다. 한 번 쓰고 끝내는 글이 아니라 계속 고치는 문서라, 발행일이 아니라 마지막으로 손댄 날 순서로 놓습니다."
      counts={[`${notes.length} NOTES`, `${verified} VERIFIED`]}
    />

    <dl class="legend">
      {
        NOTE_STATUS.map((s) => (
          <div class="legend-row">
            <dt class="meta" data-status={s}>
              {s}
            </dt>
            <dd>{NOTE_STATUS_NOTE[s]}</dd>
          </div>
        ))
      }
    </dl>

    <div class="ledger">
      {
        notes.map((note) => (
          <NoteRow
            href={href(`/notes/${note.id}/`)}
            title={note.data.title}
            summary={note.data.summary}
            status={note.data.status}
            touched={touchedAt(note)}
            revised={Boolean(note.data.updated)}
            tags={note.data.tags}
          />
        ))
      }
    </div>

    <p class="tail">별표(<span class="star">*</span>)는 처음 쓴 뒤 다시 손댄 노트</p>
  </div>
</BaseLayout>

<style>
  .legend {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  .legend-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem 1.5rem;
    padding: 0.7rem 0;
  }
  .legend-row + .legend-row {
    border-top: 1px solid var(--line-soft);
  }

  @media (min-width: 34rem) {
    .legend-row {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
    }
  }

  .legend dt[data-status='verified'] {
    color: var(--accent-ink);
  }
  .legend dt[data-status='rough'] {
    color: var(--signal);
  }
  .legend dt[data-status='overturned'] {
    text-decoration: line-through;
  }

  .legend dd {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .tail {
    margin-top: 1.5rem;
    color: var(--ink-3);
    font-size: 0.8125rem;
  }
  .star {
    color: var(--accent);
    font-family: var(--font-mono);
  }
</style>
