---
import { href } from '../../lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import WritingRow from '../../components/WritingRow.astro';
import { getSeriesWithPosts } from '../../lib/content';

export async function getStaticPaths() {
  const groups = await getSeriesWithPosts();
  return groups.map(({ entry, posts }) => ({
    params: { slug: entry.id },
    props: { entry, posts },
  }));
}

const { entry, posts } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="frame">
    <PageHead
      eyebrow="Series"
      title={entry.data.title}
      lead={entry.data.summary}
      counts={[`${posts.length} PARTS`, entry.data.status]}
    />

    <div class="ledger">
      {
        posts.map((post, i) => (
          <WritingRow
            href={href(`/writing/${post.id}/`)}
            title={post.data.title}
            summary={post.data.summary}
            date={post.data.date}
            tags={post.data.tags}
            seriesLabel={`PART ${String(i + 1).padStart(2, '0')}`}
          />
        ))
      }
    </div>

    <p class="tail">
      <a class="link-more" href={href('/series/')}>← All series</a>
    </p>
  </div>
</BaseLayout>

<style>
  .tail {
    margin-top: 1.75rem;
  }
</style>
