---
import { href } from '../../lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getDecisions, touchedAt } from '../../lib/content';
import { DECISION_STATUS, DECISION_STATUS_NOTE } from '../../lib/taxonomy';

const decisions = await getDecisions();
const active = decisions.filter((d) => d.data.status === 'active').length;
---

<BaseLayout
  title="Decisions"
  description="Calls I made while doing AX work, with what I dropped and when I would revisit."
>
  <div class="frame">
    <PageHead
      eyebrow="Decisions"
      title="Decisions"
      lead="고민하고 고른 것을 남깁니다. 무엇을 골랐는지보다 무엇을 버렸고 어떤 조건이면 다시 볼지가 본문입니다. 뒤집히면 새로 쓰지 않고 그 문서를 고칩니다."
      counts={[`${decisions.length} DECISIONS`, `${active} ACTIVE`]}
    />

    <dl class="legend">
      {
        DECISION_STATUS.map((s) => (
          <div class="legend-row">
            <dt class="meta" data-status={s}>
              {s}
            </dt>
            <dd>{DECISION_STATUS_NOTE[s]}</dd>
          </div>
        ))
      }
    </dl>

    <div class="ledger">
      {
        decisions.map((d) => (
          <EntryRow
            href={href(`/decisions/${d.id}/`)}
            kind="decision"
            title={d.data.title}
            summary={d.data.summary}
            layer={d.data.layer}
            status={d.data.status}
            touched={touchedAt(d)}
            revised={Boolean(d.data.updated)}
            tags={d.data.tags}
          />
        ))
      }
    </div>

    <p class="shape">
      <span class="meta">문서 형식</span>
      <span>맥락 → 선택지 → 고른 것 → 버린 것</span>
    </p>
  </div>
</BaseLayout>

<style>
  .legend {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  .legend-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem 1.5rem;
    padding: 0.7rem 0;
  }
  .legend-row + .legend-row {
    border-top: 1px solid var(--line-soft);
  }

  @media (min-width: 34rem) {
    .legend-row {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
    }
  }

  .legend dt[data-status='active'] {
    color: var(--accent-ink);
  }
  .legend dt[data-status='revisit'] {
    color: var(--signal);
  }
  .legend dt[data-status='superseded'] {
    text-decoration: line-through;
  }

  .legend dd {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .shape {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
</style>
