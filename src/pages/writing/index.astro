---
import { href } from '../../lib/href';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import WritingRow from '../../components/WritingRow.astro';
import { getPosts, makeSeriesLabeler } from '../../lib/content';

const [posts, seriesLabel] = await Promise.all([getPosts(), makeSeriesLabeler()]);
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;
---

<BaseLayout
  title="Writing"
  description="Notes on MLOps, reproducibility, and running research infrastructure."
>
  <div class="frame">
    <PageHead
      eyebrow="Writing"
      title="Writing"
      lead="Notes from the points where a judgement changed. What I dropped, before what I built. Posts are in Korean."
      counts={[`${posts.length} POSTS`, `${tagCount} TAGS`]}
    />

    <div class="ledger">
      {
        posts.map((post) => (
          <WritingRow
            href={href(`/writing/${post.id}/`)}
            title={post.data.title}
            summary={post.data.summary}
            date={post.data.date}
            tags={post.data.tags}
            seriesLabel={seriesLabel(post)}
          />
        ))
      }
    </div>

    <p class="tail">
      <a class="link-more" href={href('/rss.xml')}>Subscribe via RSS →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .tail {
    margin-top: 1.75rem;
  }
</style>
