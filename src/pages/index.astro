---
import { href } from '../lib/href';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import { getStream, getNotes, getDecisions } from '../lib/content';

const [stream, notes, decisions] = await Promise.all([getStream(12), getNotes(), getDecisions()]);
---

<BaseLayout>
  <div class="frame">
    <div class="stream-head">
      <p class="meta">Recently touched</p>
      <p class="stream-note">
        새로 쓴 순서가 아니라 <strong>최근에 고친 순서</strong>입니다. 별표(<span class="star">*</span
        >)는 처음 쓴 뒤 다시 손댄 글입니다.
      </p>
      <ul class="stream-counts">
        <li class="meta">{notes.length} NOTES</li>
        <li class="meta">{decisions.length} DECISIONS</li>
      </ul>
    </div>

    <div class="ledger">
      {
        stream.map(({ kind, entry, touched }) => {
          const base = kind === 'note' ? '/notes/' : '/decisions/';
          const start = 'created' in entry.data ? entry.data.created : entry.data.decided;
          return (
            <EntryRow
              href={href(`${base}${entry.id}/`)}
              kind={kind}
              title={entry.data.title}
              summary={entry.data.summary}
              layer={entry.data.layer}
              status={entry.data.status}
              touched={touched}
              revised={touched.getTime() !== start.getTime()}
              tags={entry.data.tags}
              showKind
            />
          );
        })
      }
    </div>

    <p class="tail">
      <a class="link-more" href={href('/notes/')}>All notes →</a>
      <a class="link-more" href={href('/decisions/')}>All decisions →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .stream-head {
    padding-top: 3.5rem;
    padding-bottom: 1.5rem;
  }

  .stream-note {
    margin-top: 0.8rem;
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .stream-note strong {
    color: var(--ink);
    font-weight: 600;
  }
  .star {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .stream-counts {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin-top: 1rem;
  }

  .tail {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
