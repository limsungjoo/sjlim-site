---
import { href } from '../lib/href';
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingRow from '../components/WritingRow.astro';
import NoteRow from '../components/NoteRow.astro';
import { getPosts, getNotes, getProjects, makeSeriesLabeler, touchedAt } from '../lib/content';

const [posts, notes, projects, seriesLabel] = await Promise.all([
  getPosts(),
  getNotes(),
  getProjects(),
  makeSeriesLabeler(),
]);

const featured = projects.slice(0, 3);
const recentPosts = posts.slice(0, 3);
const recentNotes = notes.slice(0, 4);
---

<BaseLayout>
  <section class="frame section section-first">
    <div class="sec-head">
      <h2 class="sec-title">Portfolio</h2>
      <a class="link-more" href={href('/portfolio/')}>All work →</a>
    </div>
    <div class="ledger">
      {
        featured.map((p) => (
          <article class="row">
            <div class="row-rail">
              <span class="chip" data-state={p.data.state}>
                {p.data.state}
              </span>
              <span class="meta">{p.data.period}</span>
            </div>
            <div>
              <h3 class="row-title">
                <a href={href(`/portfolio/#${p.id}`)} class="row-link">
                  {p.data.title}
                </a>
              </h3>
              <p class="row-summary">{p.data.summary}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="frame section">
    <div class="sec-head">
      <h2 class="sec-title">Writing</h2>
      <a class="link-more" href={href('/writing/')}>All posts →</a>
    </div>
    <div class="ledger">
      {
        recentPosts.map((post) => (
          <WritingRow
            href={href(`/writing/${post.id}/`)}
            title={post.data.title}
            summary={post.data.summary}
            date={post.data.date}
            tags={post.data.tags}
            seriesLabel={seriesLabel(post)}
          />
        ))
      }
    </div>
  </section>

  <section class="frame section">
    <div class="sec-head">
      <h2 class="sec-title">Notes</h2>
      <a class="link-more" href={href('/notes/')}>All notes →</a>
    </div>
    <div class="ledger">
      {
        recentNotes.map((note) => (
          <NoteRow
            href={href(`/notes/${note.id}/`)}
            title={note.data.title}
            summary={note.data.summary}
            status={note.data.status}
            touched={touchedAt(note)}
            revised={Boolean(note.data.updated)}
            tags={note.data.tags}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: 3.5rem;
  }

  .section-first {
    margin-top: 3.25rem;
  }

  .row-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
